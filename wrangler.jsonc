{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-builder",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "./dist",
  "services": [{ "binding": "KNOWLEDGE_AGENT", "service": "resume-builder-knowledge-agent" }],
  "vars": {
    "INTERNAL_SERVICE_KEY": "rb_internal_agent_sec_2026"
  }
}
