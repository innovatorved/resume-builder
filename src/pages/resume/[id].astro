---
import { and, desc, eq } from "drizzle-orm";
import { LatexEditorSplit } from "@/components/editor/latex-editor-split";
import Layout from "@/layouts/Layout.astro";
import { auth } from "@/lib/auth";
import { db } from "@/lib/db";
import { resume, resumeVersion } from "@/lib/db/schema";
import type { ResumeData } from "@/types/resume";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session?.user) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

const DEFAULT_RESUME: ResumeData = {
  personalInfo: {
    name: session.user.name || "",
    title: "",
    phone: "",
    email: session.user.email || "",
    linkedin: "",
    location: "",
  },
  summary: "",
  experience: [],
  education: [],
  skills: [],
  certifications: [],
  projects: [],
  languages: [],
};

const isNewResume = id === "new";
let initialResume: {
  id: string;
  name: string;
  data: ResumeData;
  templateId: string | null;
  currentVersionId: string | null;
  createdAt: Date;
  updatedAt: Date;
  rawLatex: string | null;
} | null = null;

if (!isNewResume) {
  const [found] = await db
    .select({
      id: resume.id,
      name: resume.name,
      data: resume.data,
      templateId: resume.templateId,
      currentVersionId: resume.currentVersionId,
      createdAt: resume.createdAt,
      updatedAt: resume.updatedAt,
    })
    .from(resume)
    .where(and(eq(resume.id, id), eq(resume.userId, session.user.id)))
    .limit(1);

  if (!found) {
    return Astro.redirect("/");
  }

  // Fetch the version snapshot by currentVersionId first, then fallback to latest by number
  let latestVersion:
    | { id: string; versionNumber: number; rawLatex: string | null; structuredData: unknown }
    | undefined;

  if (found.currentVersionId) {
    const [byId] = await db
      .select({
        id: resumeVersion.id,
        versionNumber: resumeVersion.versionNumber,
        rawLatex: resumeVersion.rawLatex,
        structuredData: resumeVersion.structuredData,
      })
      .from(resumeVersion)
      .where(eq(resumeVersion.id, found.currentVersionId))
      .limit(1);
    latestVersion = byId;
  }

  if (!latestVersion) {
    const [byNumber] = await db
      .select({
        id: resumeVersion.id,
        versionNumber: resumeVersion.versionNumber,
        rawLatex: resumeVersion.rawLatex,
        structuredData: resumeVersion.structuredData,
      })
      .from(resumeVersion)
      .where(eq(resumeVersion.resumeId, id))
      .orderBy(desc(resumeVersion.versionNumber))
      .limit(1);
    latestVersion = byNumber;
  }

  const rawData = typeof found.data === "string" ? JSON.parse(found.data) : found.data;
  initialResume = {
    ...found,
    data: (rawData || DEFAULT_RESUME) as ResumeData,
    rawLatex: latestVersion?.rawLatex || null,
    currentVersionId: latestVersion?.id || found.currentVersionId,
  };
}
---

{
  isNewResume ? (
    <Layout title="Creating Resume | LaTeX Resume Studio">
      <div class="min-h-screen flex items-center justify-center bg-black text-neutral-300 text-sm">
        Creating your new resume...
      </div>
      <script is:inline define:vars={{ defaultResume: DEFAULT_RESUME }}>
        (async () => {
          try {
            const res = await fetch("/api/resumes", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name: "Untitled Resume", data: defaultResume }),
            });
            const json = await res.json();
            if (res.ok && json?.success && json?.data?.id) {
              window.location.replace(`/resume/${json.data.id}`);
              return;
            }
          } catch {}
          window.location.replace("/");
        })();
      </script>
    </Layout>
  ) : (
    initialResume && (
      <Layout title={`${initialResume.name} | LaTeX Resume Studio`}>
        <LatexEditorSplit client:only="react" initialResume={initialResume} />
      </Layout>
    )
  )
}
