---
import { and, desc, eq } from "drizzle-orm";
import { LatexEditorSplit } from "@/components/editor/latex-editor-split";
import Layout from "@/layouts/Layout.astro";
import { auth } from "@/lib/auth";
import { db } from "@/lib/db";
import { resume, resumeVersion } from "@/lib/db/schema";
import { generateCleanModern } from "@/lib/templates";
import type { ResumeData } from "@/types/resume";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session?.user) {
  return Astro.redirect("/login");
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

const DEFAULT_RESUME: ResumeData = {
  personalInfo: {
    name: session.user.name || "",
    title: "",
    phone: "",
    email: session.user.email || "",
    linkedin: "",
    location: "",
  },
  summary: "",
  experience: [],
  education: [],
  skills: [],
  certifications: [],
  projects: [],
  languages: [],
};

// If navigating to /resume/new, create a new resume and initial version record, then redirect to its ID
if (id === "new") {
  const newId = crypto.randomUUID();
  const versionId = crypto.randomUUID();
  const now = new Date();
  const initialLatex = generateCleanModern(DEFAULT_RESUME);

  await db.insert(resume).values({
    id: newId,
    userId: session.user.id,
    name: "Untitled Resume",
    data: DEFAULT_RESUME,
    templateId: "clean-modern",
    currentVersionId: versionId,
    createdAt: now,
    updatedAt: now,
  });

  await db.insert(resumeVersion).values({
    id: versionId,
    resumeId: newId,
    versionNumber: 1,
    sourceKey: `resumes/${session.user.id}/${newId}/source/${versionId}.tex`,
    pdfKey: null,
    structuredData: DEFAULT_RESUME,
    rawLatex: initialLatex,
    isLatexCustom: false,
    changeSummary: "Initial version",
    createdAt: now,
  });

  return Astro.redirect(`/resume/${newId}`);
}

const [found] = await db
  .select({
    id: resume.id,
    name: resume.name,
    data: resume.data,
    templateId: resume.templateId,
    currentVersionId: resume.currentVersionId,
    createdAt: resume.createdAt,
    updatedAt: resume.updatedAt,
  })
  .from(resume)
  .where(and(eq(resume.id, id), eq(resume.userId, session.user.id)))
  .limit(1);

if (!found) {
  return Astro.redirect("/");
}

// Fetch the latest saved version snapshot to preserve exact LaTeX code and history
const [latestVersion] = await db
  .select({
    id: resumeVersion.id,
    versionNumber: resumeVersion.versionNumber,
    rawLatex: resumeVersion.rawLatex,
    structuredData: resumeVersion.structuredData,
  })
  .from(resumeVersion)
  .where(eq(resumeVersion.resumeId, id))
  .orderBy(desc(resumeVersion.versionNumber))
  .limit(1);

const rawData = typeof found.data === "string" ? JSON.parse(found.data) : found.data;
const initialResume = {
  ...found,
  data: (rawData || DEFAULT_RESUME) as ResumeData,
  rawLatex: latestVersion?.rawLatex || null,
  currentVersionId: latestVersion?.id || found.currentVersionId,
};
---

<Layout title={`${initialResume.name} | LaTeX Resume Studio`}>
  <LatexEditorSplit client:only="react" initialResume={initialResume} />
</Layout>
